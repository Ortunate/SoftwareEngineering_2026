static constexpr std::array<Event,92> kEnd10{{
    {Op::TextDelay, 70, 12, ""},
    {Op::Background, 7, 0, ""},
    {Op::FadeIn, 30000, 0, ""},
    {Op::Wait, 120, 120, ""},
    {Op::FadeIn, 180, 0, ""},
    {Op::Wait, 180, 180, ""},
    {Op::Color, 6579300, 0, ""},
    {Op::Text, 0, 0, "　幻想乡迎来了夏天。\n　歇息了好一阵子的太阳终于露了面，\n　将所有的红雾一扫而空。\n　窗户稀少的红魔馆也坦坦荡荡地现身在光天化日之下…"},
    {Op::WaitClear, 1200, 4, ""},
    {Op::Background, 8, 0, ""},
    {Op::Color, 13461830, 0, ""},
    {Op::Text, 0, 0, "　咲夜　「唉——事又多、天又热，真受够了，\n　　　　　所以说还是雾天好啊」"},
    {Op::WaitClear, 1200, 4, ""},
    {Op::Text, 0, 0, "　咲夜　「啊，快到吃茶点的时间了\n　　　　　不过也不急，反正可以停止时间慢慢准备」"},
    {Op::WaitClear, 1200, 4, ""},
    {Op::Color, 6133299, 0, ""},
    {Op::Text, 0, 0, "　？？　「茶点还没好吗？」"},
    {Op::Wait, 1200, 4, ""},
    {Op::Color, 13461830, 0, ""},
    {Op::Text, 0, 0, "　咲夜　「好的，大小姐，我这就过来」"},
    {Op::WaitClear, 1200, 4, ""},
    {Op::Background, 9, 0, ""},
    {Op::Text, 0, 0, "　咲夜　「让您久等了」"},
    {Op::Wait, 1200, 4, ""},
    {Op::Color, 6133299, 0, ""},
    {Op::Text, 0, 0, "　魔理沙「辛苦啦」"},
    {Op::WaitClear, 1200, 4, ""},
    {Op::Color, 13461830, 0, ""},
    {Op::Text, 0, 0, "　咲夜　「今天的红茶是产自康提的稀世珍品」"},
    {Op::Wait, 1200, 4, ""},
    {Op::Color, 6133299, 0, ""},
    {Op::Text, 0, 0, "　魔理沙「颜色太红了，看着就倒胃口」"},
    {Op::WaitClear, 1200, 4, ""},
    {Op::Color, 13461830, 0, ""},
    {Op::Text, 0, 0, "　咲夜　「顺便一提，蛋糕里面也加入了珍品」"},
    {Op::Wait, 1200, 4, ""},
    {Op::Color, 6133299, 0, ""},
    {Op::Text, 0, 0, "　魔理沙「你到底加了什么(^^;」"},
    {Op::Wait, 1200, 4, ""},
    {Op::Color, 13461830, 0, ""},
    {Op::Text, 0, 0, "　咲夜　「就是竹花什么的」"},
    {Op::WaitClear, 1200, 4, ""},
    {Op::Color, 13461830, 0, ""},
    {Op::Text, 0, 0, "　咲夜　「虽说竹子六十年才开一次花，但我能够操控时间，\n　　　　　所以能让它立刻绽放」"},
    {Op::WaitClear, 1200, 4, ""},
    {Op::Color, 6133299, 0, ""},
    {Op::Text, 0, 0, "　魔理沙「不过，这玩意儿好吃吗？」"},
    {Op::Wait, 1200, 4, ""},
    {Op::Color, 13461830, 0, ""},
    {Op::Text, 0, 0, "　咲夜「这可是珍品」"},
    {Op::WaitClear, 1200, 4, ""},
    {Op::Background, 10, 0, ""},
    {Op::Color, 6506189, 0, ""},
    {Op::Text, 0, 0, "蕾米莉亚「不是，你怎么堂而皇之地待在我家呢\n　　　　　等等，你怎么还擅自吃起了别人的茶点呀——」"},
    {Op::Wait, 1200, 4, ""},
    {Op::Color, 6133299, 0, ""},
    {Op::Text, 0, 0, "　魔理沙「人的茶点人来吃嘛」"},
    {Op::WaitClear, 1200, 4, ""},
    {Op::Color, 13461830, 0, ""},
    {Op::Text, 0, 0, "　咲夜　「啊，大小姐，这里还有呢」"},
    {Op::Wait, 1200, 4, ""},
    {Op::Color, 6506189, 0, ""},
    {Op::Text, 0, 0, "蕾米莉亚「今天的茶点是什么？」"},
    {Op::Wait, 1200, 4, ""},
    {Op::Color, 13461830, 0, ""},
    {Op::Text, 0, 0, "　咲夜　「是珍品」"},
    {Op::WaitClear, 1200, 4, ""},
    {Op::Color, 6506189, 0, ""},
    {Op::Text, 0, 0, "蕾米莉亚「好耶——我最喜欢吃啦」"},
    {Op::Wait, 1200, 4, ""},
    {Op::Color, 6133299, 0, ""},
    {Op::Text, 0, 0, "　魔理沙「你可别喜欢上什么怪东西呀（汗）」"},
    {Op::WaitClear, 1200, 4, ""},
    {Op::Color, 6133299, 0, ""},
    {Op::Text, 0, 0, "　魔理沙「…不是我说，今年夏天也太热了吧。」"},
