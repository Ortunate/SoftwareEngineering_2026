    {Op::WaitClear, 1200, 4, ""},
    {Op::Color, 6133299, 0, ""},
    {Op::Background, 5, 0, ""},
    {Op::Text, 0, 0, "　灵梦　「你算哪门子的人！！」"},
    {Op::Wait, 1200, 4, ""},
    {Op::Color, 6506189, 0, ""},
