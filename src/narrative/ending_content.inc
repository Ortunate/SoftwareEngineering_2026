    {Op::FadeIn, 180, 0, ""},
    {Op::Wait, 180, 180, ""},
    {Op::Color, 6579300, 0, ""},
    {Op::Text, 0, 0, "　夏天的神社门可罗雀。\n　歇息了好一阵子的太阳终于露了面，\n　神社周边接连数日都是大晴天。\n　四下不见人影，唯有聒噪的蝉鸣不绝于耳…"},
    {Op::WaitClear, 1200, 4, ""},
    {Op::Color, 6133299, 0, ""},
    {Op::Background, 1, 0, ""},
    {Op::Text, 0, 0, "　灵梦　「这才称得上是夏天嘛\n　　　　　之前那种阴沉沉的夏天，连葵花籽油都要减产啦」"},
    {Op::WaitClear, 1200, 4, ""},
    {Op::Text, 0, 0, "　灵梦　「要是来神社参拜的人再多点就更好了」"},
    {Op::Wait, 1200, 4, ""},
    {Op::Color, 6506189, 0, ""},
    {Op::Text, 0, 0, "　？？　「确实啊——\n　　　　　萧条成这样，你这生意真能做吗？」"},
    {Op::WaitClear, 1200, 4, ""},
    {Op::Background, 2, 0, ""},
    {Op::Color, 6133299, 0, ""},
    {Op::Text, 0, 0, "　灵梦　「你这家伙又不是人\n　　　　　你要别在这瞎逛，生意没准还能好点呢？」"},
    {Op::Wait, 1200, 4, ""},
    {Op::Color, 6506189, 0, ""},
    {Op::Text, 0, 0, "蕾米莉亚「真没礼貌。\n　　　　　像这么偏僻的地方，就算我不在，\n　　　　　压根也不会有人来」"},
    {Op::WaitClear, 1200, 4, ""},
    {Op::Color, 6133299, 0, ""},
    {Op::Text, 0, 0, "　灵梦　「我说，你不是害怕阳光吗？\n　　　　　赶紧给我灰飞烟灭啊。」"},
    {Op::Wait, 1200, 4, ""},
    {Op::Color, 6506189, 0, ""},
    {Op::Text, 0, 0, "蕾米莉亚「我撑着阳伞呢」"},
    {Op::Wait, 1200, 4, ""},
    {Op::Color, 6133299, 0, ""},
    {Op::Text, 0, 0, "　灵梦　「撑把伞就行？\n　　　　　那你弄出那么多雾干啥(^^;」"},
    {Op::WaitClear, 1200, 4, ""},
    {Op::Background, 3, 0, ""},
    {Op::Color, 6506189, 0, ""},
    {Op::Text, 0, 0, "蕾米莉亚「快住手，我要被晒到了！」"},
    {Op::Wait, 1200, 4, ""},
    {Op::Color, 6133299, 0, ""},
    {Op::Text, 0, 0, "　灵梦　「瞧你这惨白的脸色，\n　　　　　还是稍微晒黑点比较好吧？」"},
    {Op::Wait, 1200, 4, ""},
    {Op::Color, 6506189, 0, ""},
    {Op::Text, 0, 0, "蕾米莉亚「晒黑之前我会先汽化的」"},
    {Op::WaitClear, 1200, 4, ""},
    {Op::Color, 6506189, 0, ""},
    {Op::Text, 0, 0, "蕾米莉亚「一旦吸入我汽化形成的气体，\n　　　　　就会获得永恒的生命」"},
    {Op::Wait, 1200, 4, ""},
    {Op::Color, 6133299, 0, ""},
    {Op::Text, 0, 0, "　灵梦　「…那我可不干」"},
    {Op::Wait, 1200, 4, ""},
    {Op::Color, 6506189, 0, ""},
    {Op::Text, 0, 0, "蕾米莉亚「是吧是吧？」"},
    {Op::WaitClear, 1200, 4, ""},
    {Op::Color, 6133299, 0, ""},
    {Op::Text, 0, 0, "　灵梦　「给我20年的寿命就够了」"},
    {Op::Wait, 1200, 4, ""},
    {Op::Color, 6506189, 0, ""},
    {Op::Text, 0, 0, "蕾米莉亚「呜哇」"},
    {Op::WaitClear, 1200, 4, ""},
    {Op::Color, 6579300, 0, ""},
    {Op::Text, 0, 0, "　平静的夏日兼具无穷的时间。\n　永恒的神社似乎千秋万代也不会改变。"},
    {Op::Text, 0, 0, "　　"},
    {Op::Wait, 1200, 4, ""},
    {Op::Text, 0, 0, "　ＥＮＤＩＮＧ　Ｎｏ．３"},
    {Op::WaitClear, 1200, 4, ""},
    {Op::MusicFade, 5, 0, ""},
    {Op::FadeOut, 240, 0, ""},
    {Op::Wait, 240, 240, ""},
    {Op::Finish, 0, 0, ""},
}};
static constexpr std::array<Event,78> kEnd01{{
