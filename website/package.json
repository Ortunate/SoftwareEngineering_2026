{
  "name": "koumakyou-wiki",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "prepare:content": "node scripts/generate.mjs",
    "dev": "npm run prepare:content && vitepress dev . --host 127.0.0.1",
    "build": "npm run prepare:content && vitepress build .",
    "preview": "vitepress preview . --host 127.0.0.1",
    "test": "node --test scripts/*.test.mjs",
    "check": "node scripts/check.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "mermaid": "^12.2.0",
    "vitepress": "^1.6.4",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "cheerio": "^1.1.2"
  },
  "overrides": {
    "vite": "^6.4.5"
  }
}
