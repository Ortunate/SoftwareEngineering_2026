    {Op::Color, 6506189, 0, ""},
    {Op::Text, 0, 0, "蕾米莉亚「你瞧瞧，还是雾天好吧\n　　　　　都怪你当时非要让我收手」"},
    {Op::Wait, 1200, 4, ""},
    {Op::Color, 6133299, 0, ""},
    {Op::Text, 0, 0, "　魔理沙「…有时候就是会这么想嘛」"},
    {Op::WaitClear, 1200, 4, ""},
    {Op::Color, 6579300, 0, ""},
    {Op::Text, 0, 0, "\n　今日，夏色的幻想依然一派祥和，令时间停止不前。\n　或许，时间再也不会有恢复前进的那一天了。"},
    {Op::Text, 0, 0, "　　"},
