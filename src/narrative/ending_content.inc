    {Op::Wait, 1200, 4, ""},
    {Op::Color, 6133299, 0, ""},
    {Op::Text, 0, 0, "　灵梦　「凭什么我要在大白天陪着怪物讲鬼故事呀」"},
    {Op::WaitClear, 1200, 4, ""},
    {Op::Background, 6, 0, ""},
    {Op::Color, 6506189, 0, ""},
    {Op::Text, 0, 0, "蕾米莉亚「等到夜里再讲，也可以哦」"},
    {Op::Wait, 1200, 4, ""},
    {Op::Color, 6133299, 0, ""},
    {Op::Text, 0, 0, "　灵梦　「等你个头」"},
    {Op::WaitClear, 1200, 4, ""},
    {Op::Color, 6133299, 0, ""},
    {Op::Text, 0, 0, "　灵梦　「…说呀？」"},
    {Op::Wait, 1200, 4, ""},
    {Op::Color, 6506189, 0, ""},
    {Op::Text, 0, 0, "蕾米莉亚「啊？」"},
    {Op::Wait, 1200, 4, ""},
    {Op::Color, 6133299, 0, ""},
    {Op::Text, 0, 0, "　灵梦　「你要讲什么鬼故事？」"},
